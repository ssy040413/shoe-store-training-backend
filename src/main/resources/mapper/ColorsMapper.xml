<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xys.mapper.ColorsMapper">

    <!-- 结果映射：颜色信息 -->
    <resultMap id="BaseResultMap" type="com.xys.entity.Colors">
        <id property="colorId" column="color_id"/>
        <result property="colorName" column="color_name"/>
        <result property="status" column="status"/>
        <result property="remarks" column="remarks"/>
    </resultMap>

    <!-- 查询所有颜色 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM colors ORDER BY color_id
    </select>

    <!-- 根据ID查询颜色 -->
    <select id="findById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM colors WHERE color_id = #{colorId}
    </select>

    <!-- 添加颜色 -->
    <insert id="insert" parameterType="com.xys.entity.Colors" useGeneratedKeys="true" keyProperty="colorId">
        INSERT INTO colors (color_name, status, remarks) 
        VALUES (#{colorName}, #{status}, #{remarks})
    </insert>

    <!-- 更新颜色 -->
    <update id="update" parameterType="com.xys.entity.Colors">
        UPDATE colors SET 
            color_name = #{colorName}, 
            status = #{status}, 
            remarks = #{remarks} 
        WHERE color_id = #{colorId}
    </update>

    <!-- 删除颜色 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM colors WHERE color_id = #{colorId}
    </delete>

    <!-- 查询启用状态的颜色 -->
    <select id="findActiveColors" resultMap="BaseResultMap">
        SELECT * FROM colors WHERE status = '1' ORDER BY color_id
    </select>

    <!-- 统计使用指定颜色的鞋子数量 -->
    <select id="countShoesUsingColor" parameterType="java.lang.Integer" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM shoes WHERE color_id = #{colorId}
    </select>

</mapper>