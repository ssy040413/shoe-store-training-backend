<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xys.mapper.BrandsMapper">

    <!-- 结果映射：品牌信息 -->
    <resultMap id="BaseResultMap" type="com.xys.entity.Brands">
        <id property="brand_id" column="brand_id"/>
        <result property="brand_name" column="brand_name"/>
        <result property="status" column="status"/>
        <result property="remarks" column="remarks"/>
    </resultMap>

    <!-- 查询所有品牌 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM brands ORDER BY brand_id
    </select>

    <!-- 根据ID查询品牌 -->
    <select id="findById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM brands WHERE brand_id = #{brand_id}
    </select>

    <!-- 添加品牌 -->
    <insert id="insert" parameterType="com.xys.entity.Brands" useGeneratedKeys="true" keyProperty="brand_id">
        INSERT INTO brands (brand_name, status, remarks) 
        VALUES (#{brand_name}, #{status}, #{remarks})
    </insert>

    <!-- 更新品牌 -->
    <update id="update" parameterType="com.xys.entity.Brands">
        UPDATE brands SET 
            brand_name = #{brand_name}, 
            status = #{status}, 
            remarks = #{remarks} 
        WHERE brand_id = #{brand_id}
    </update>

    <!-- 删除品牌 -->
    <delete id="delete" parameterType="java.lang.Integer">
        DELETE FROM brands WHERE brand_id = #{brand_id}
    </delete>

    <!-- 更新品牌状态 -->
    <update id="updateStatus">
        UPDATE brands SET status = #{status} WHERE brand_id = #{brand_id}
    </update>

    <!-- 查询启用状态的品牌 -->
    <select id="findActiveBrands" resultMap="BaseResultMap">
        SELECT * FROM brands WHERE status = 1 ORDER BY brand_id
    </select>

    <!-- 检查品牌是否被鞋子表引用 -->
    <select id="countShoesUsingBrand" parameterType="java.lang.Integer" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM shoes WHERE brand_id = #{brand_id}
    </select>

</mapper>